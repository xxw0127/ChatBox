* {
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
    color: #FFFFFF;
}

QMainWindow, QDialog {
    background: #0E1621;
}

QWidget#LoginPage {
    background: #0E1621;
}

QFrame#LoginCard {
    background: #17212B;
    border: 1px solid #101921;
    border-radius: 16px;
}

QLabel#AppLogo {
    background: #5EB5F7;
    color: #FFFFFF;
    border-radius: 28px;
    font-size: 28px;
    font-weight: 600;
}

QLabel#AppTitle {
    font-size: 26px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#AppSubtitle {
    color: #708499;
    font-size: 12px;
}

QLabel#SectionLabel {
    color: #708499;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 6px 4px 6px;
}

QLabel#ContextTitle {
    font-size: 16px;
    font-weight: 600;
    padding: 2px 4px;
}

QLabel#MutedLabel {
    color: #708499;
    font-size: 12px;
}

QLineEdit, QSpinBox {
    background: #232E3C;
    border: 1px solid transparent;
    border-radius: 18px;
    min-height: 36px;
    padding: 0 14px;
    selection-background-color: #5EB5F7;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QSpinBox:focus {
    background: #17212B;
    border: 1px solid #5EB5F7;
}

QTextEdit#MessageInput {
    background: #232E3C;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 8px 12px;
}

QTextEdit#MessageInput:focus {
    background: #17212B;
    border: 1px solid #5EB5F7;
}

QPushButton {
    background: #232E3C;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
}

QPushButton[keyboardFocus="true"]:focus {
    border: 2px solid #5EB5F7;
    padding: 6px 10px;
}

QPushButton:hover {
    background: #2B3B4E;
}

QPushButton:pressed {
    background: #101921;
}

QPushButton:disabled {
    color: #7C8E9F;
    background: #0E1621;
}

QPushButton#PrimaryButton {
    background: #2C74CC;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #2660C7;
}

QPushButton#PrimaryButton[keyboardFocus="true"]:focus {
    border: 2px solid #5EB5F7;
    padding: 6px 10px;
}

QPushButton#PrimaryButton:pressed {
    background: #1F54B0;
}

QPushButton#PrimaryButton:disabled {
    background: #2B3B4E;
    color: #708499;
}

QPushButton#SendButton {
    background: #2C74CC;
    color: #FFFFFF;
    border-radius: 18px;
    padding: 8px 14px;
}

QPushButton#SendButton:hover {
    background: #2660C7;
}

QPushButton#SendButton[keyboardFocus="true"]:focus {
    border: 2px solid #5EB5F7;
    padding: 6px 12px;
}

QPushButton#SendButton:pressed {
    background: #1F54B0;
}

QPushButton#IconButton {
    padding: 7px;
}

QToolButton#HeaderAction {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0 8px;
    font-size: 12px;
    color: #6A6E74;
}

QToolButton#HeaderAction:hover {
    background: #232E3C;
    color: #2C74CC;
}

QToolButton#HeaderAction:pressed {
    background: #2B3B4E;
}

QPushButton#SidebarAction, QPushButton#FooterAction {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0 8px;
    color: #FFFFFF;
    font-size: 13px;
    text-align: left;
}

QPushButton#SidebarAction:hover, QPushButton#FooterAction:hover {
    background: #0E1621;
}

QPushButton#DangerOutlineButton {
    background: transparent;
    border: 1px solid #101921;
    border-radius: 8px;
    color: #FF6B6B;
    padding: 6px 12px;
}

QPushButton#DangerOutlineButton:hover {
    background: #0E1621;
}

QPushButton#DangerFooterAction {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0 8px;
    color: #FF6B6B;
    font-size: 13px;
}

QPushButton#DangerFooterAction:hover {
    background: #0E1621;
}

QLabel#FriendRequestBadge {
    background: #2C74CC;
    color: #FFFFFF;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#Sidebar {
    background: #17212B;
    border-right: 1px solid #101921;
}

QWidget#RightSidebar {
    background: #17212B;
    border-left: 1px solid #101921;
}

QWidget#ChatPanel {
    background: #0E1621;
}

QWidget#ChatHeader {
    background: #17212B;
    border-bottom: 1px solid #101921;
}

QWidget#Composer {
    background: #17212B;
    border-top: 1px solid #101921;
}

QTextBrowser {
    background: #0E1621;
    border: none;
    padding: 8px;
}

QPushButton#JumpLatestButton {
    background: #17212B;
    border: 1px solid #101921;
    border-radius: 14px;
    padding: 5px 12px;
    color: #5EB5F7;
    font-size: 12px;
}

QPushButton#JumpLatestButton:hover {
    background: #232E3C;
}

QFrame#MentionPopup {
    background: #17212B;
    border: 1px solid #101921;
    border-radius: 12px;
}

QListWidget#MentionList {
    background: transparent;
    border: none;
    outline: none;
}

QLabel#MentionEmpty {
    color: #8A9AAB;
    font-size: 12px;
    background: transparent;
}

QStackedWidget {
    background: #0E1621;
}

QStatusBar {
    background: #17212B;
    border-top: 1px solid #101921;
    color: #708499;
}

QStatusBar QLabel {
    color: #708499;
    padding-left: 6px;
}

QListWidget {
    background: transparent;
    border: none;
    padding: 0;
}

QListWidget[keyboardFocus="true"]:focus {
    border: 2px solid #5EB5F7;
    border-radius: 10px;
}

QListWidget::item {
    padding: 9px 10px;
    border-radius: 8px;
    margin: 2px 6px;
}

QListWidget::item:hover {
    background: #0E1621;
    border: 1px solid transparent;
}

/* 见 style.qss：选中行整行反色，深色主题下同样是蓝底白字。 */
QListWidget::item:selected {
    background: #2C74CC;
    border: 1px solid #2C74CC;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #7C8E9F;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #708499;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #7C8E9F;
    background: #17212B;
}

QCheckBox::indicator:checked {
    background: #5EB5F7;
    border: 1px solid #5EB5F7;
    image: url(:/icons/check.png);
}

QCheckBox[keyboardFocus="true"]::indicator:focus {
    border: 2px solid #5EB5F7;
}

/* 见 style.qss：三种控件原先无规则，深色下会露出系统浅色外观。 */
QComboBox {
    background: #232E3C;
    border: 1px solid #101921;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 20px;
}

QComboBox:hover {
    background: #2B3B4E;
}

QComboBox:focus {
    background: #17212B;
    border: 1px solid #5EB5F7;
}

QComboBox:disabled {
    background: #0E1621;
    color: #7C8E9F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron-dark.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background: #17212B;
    border: 1px solid #101921;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #2C74CC;
    selection-color: #FFFFFF;
}

QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #7C8E9F;
    background: #17212B;
}

QRadioButton::indicator:checked {
    border: 1px solid #5EB5F7;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                stop:0 #5EB5F7, stop:0.45 #5EB5F7,
                                stop:0.55 #17212B, stop:1 #17212B);
}

QRadioButton::indicator:disabled {
    border-color: #101921;
}

QRadioButton[keyboardFocus="true"]::indicator:focus {
    border: 2px solid #5EB5F7;
}

QGroupBox {
    border: 1px solid #101921;
    border-radius: 12px;
    margin-top: 10px;
    padding: 14px 12px 10px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #708499;
    font-size: 11px;
    font-weight: 600;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

QMenu {
    background: #17212B;
    border: 1px solid #101921;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #232E3C;
    color: #FFFFFF;
}

QToolTip {
    background: #FFFFFF;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
}
QToolButton#MoreButton, QToolButton#AdvancedOptionsButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
}

QToolButton[keyboardFocus="true"]:focus {
    background: #2B3B4E;
    border: 2px solid #5EB5F7;
    border-radius: 8px;
}

QToolButton#MoreButton[keyboardFocus="true"]:focus,
QToolButton#AdvancedOptionsButton[keyboardFocus="true"]:focus {
    background: #2B3B4E;
    border: 2px solid #5EB5F7;
    border-radius: 8px;
}

QToolButton#MoreButton:hover, QToolButton#AdvancedOptionsButton:hover {
    background: #2B3B4E;
}

QToolButton#MoreButton:pressed, QToolButton#AdvancedOptionsButton:pressed {
    background: #2B3B4E;
}

QToolButton#MoreButton::menu-indicator {
    image: none;
    width: 0px;
}

/* Dark-specific tooltip: light-on-dark surfaces would be unreadable. */
QToolTip {
    background: #232E3C;
    color: #FFFFFF;
}


QLabel#EmptyStateTitle {
    font-size: 15px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#EmptyStateDescription {
    font-size: 13px;
    color: #708499;
}

QPushButton#EmptyStateAction {
    background: transparent;
    border: none;
    color: #5EB5F7;
    font-size: 13px;
    padding: 6px 8px;
}

QPushButton#EmptyStateAction:hover {
    color: #4EA4F6;
}

QLabel#ProfileNameLabel {
    font-size: 22px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#SettingsIdLabel {
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#SettingsCaption {
    color: #708499;
}

QLabel#HistoryPathLabel {
    color: #E4EBF5;
}

QLabel#SettingsVersion {
    color: #708499;
}

QPushButton#MyProfileButton {
    background: #17212B;
    border: none;
    border-top: 1px solid #101921;
    border-radius: 0;
    padding: 4px 2px;
}

QPushButton#MyProfileButton:hover {
    background: #0E1621;
}

QPushButton#MyProfileButton:pressed {
    background: #232E3C;
}

QLabel#AccountMenuHint {
    color: #708499;
    font-size: 18px;
    font-weight: 600;
    padding-right: 4px;
}

QLabel#MyProfileName {
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#MyProfileUid {
    font-size: 11px;
    color: #708499;
}

QLabel#MessageByteCounter {
    font-size: 11px;
}
