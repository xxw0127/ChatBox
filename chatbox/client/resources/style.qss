* {
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
    color: #000000;
}

QMainWindow, QDialog {
    background: #F4F4F5;
}

QWidget#LoginPage {
    background: #F4F4F5;
}

QFrame#LoginCard {
    background: #FFFFFF;
    border: 1px solid #E7EBF0;
    border-radius: 16px;
}

/* 品牌字母标：原本是 Qt 内联样式，切主题时不会重算，故收进 QSS。 */
QLabel#AppLogo {
    background: #2C74CC;
    color: #FFFFFF;
    border-radius: 28px;
    font-size: 28px;
    font-weight: 600;
}

QLabel#AppTitle {
    font-size: 26px;
    font-weight: 600;
    color: #000000;
}

QLabel#AppSubtitle {
    color: #6A6E74;
    font-size: 12px;
}

QLabel#EmptyStateTitle {
    font-size: 15px;
    font-weight: 600;
    color: #000000;
}

QLabel#EmptyStateDescription {
    font-size: 13px;
    color: #6A6E74;
}

QPushButton#EmptyStateAction {
    background: transparent;
    border: none;
    color: #2C74CC;
    font-size: 13px;
    padding: 6px 8px;
}

QPushButton#EmptyStateAction:hover {
    color: #2868B8;
}

QLabel#SectionLabel {
    color: #6A6E74;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 6px 4px 6px;
}

QLabel#ContextTitle {
    font-size: 16px;
    font-weight: 600;
    padding: 2px 4px;
}

QLabel#MutedLabel {
    color: #6A6E74;
    font-size: 12px;
}

QLabel#ProfileNameLabel {
    font-size: 22px;
    font-weight: 600;
    color: #000000;
}

QLabel#SettingsIdLabel {
    font-weight: 600;
    color: #000000;
}

QLabel#SettingsCaption {
    color: #6A6E74;
}

QLabel#HistoryPathLabel {
    color: #1A1A1A;
}

QLabel#SettingsVersion {
    color: #6A6E74;
}

QLineEdit, QSpinBox {
    background: #F1F1F1;
    border: 1px solid transparent;
    border-radius: 18px;
    min-height: 36px;
    padding: 0 14px;
    selection-background-color: #2C74CC;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QSpinBox:focus {
    background: #FFFFFF;
    border: 1px solid #2C74CC;
}

QTextEdit#MessageInput {
    background: #F1F1F1;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 8px 12px;
}

QTextEdit#MessageInput:focus {
    background: #FFFFFF;
    border: 1px solid #2C74CC;
}

QLabel#MessageByteCounter {
    font-size: 11px;
}

QPushButton {
    background: #F1F1F1;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
}

QPushButton[keyboardFocus="true"]:focus {
    border: 2px solid #2C74CC;
    padding: 6px 10px;
}

QPushButton:hover {
    background: #E6E6E6;
}

QPushButton:pressed {
    background: #E7EBF0;
}

QPushButton:disabled {
    color: #6B7076;
    background: #F4F4F5;
}

QPushButton#PrimaryButton {
    background: #2C74CC;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background: #2868B8;
}

QPushButton#PrimaryButton[keyboardFocus="true"]:focus {
    border: 2px solid #2C74CC;
    padding: 6px 10px;
}

QPushButton#PrimaryButton:pressed {
    background: #2461AF;
}

QPushButton#PrimaryButton:disabled {
    background: #E6E6E6;
    color: #6B7076;
}

QPushButton#SendButton {
    background: #2C74CC;
    color: #FFFFFF;
    border-radius: 18px;
    padding: 8px 14px;
}

QPushButton#SendButton:hover {
    background: #2868B8;
}

QPushButton#SendButton[keyboardFocus="true"]:focus {
    border: 2px solid #2C74CC;
    padding: 6px 12px;
}

QPushButton#SendButton:pressed {
    background: #2461AF;
}

QPushButton#IconButton {
    padding: 7px;
}

QPushButton#MyProfileButton {
    background: #FFFFFF;
    border: none;
    border-top: 1px solid #E7EBF0;
    border-radius: 0;
    padding: 4px 2px;
}

QPushButton#MyProfileButton:hover {
    background: #F4F4F5;
}

QPushButton#MyProfileButton:pressed {
    background: #F1F1F1;
}

QLabel#AccountMenuHint {
    color: #6A6E74;
    font-size: 18px;
    font-weight: 600;
    padding-right: 4px;
}

QLabel#MyProfileName {
    font-size: 13px;
    font-weight: 600;
    color: #000000;
}

QLabel#MyProfileUid {
    font-size: 11px;
    color: #6A6E74;
}

/* 标题行里的小图标按钮（好友申请）。 */
QToolButton#HeaderAction {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0 8px;
    font-size: 12px;
    color: #6A6E74;
}

QToolButton#HeaderAction:hover {
    background: #F1F1F1;
    color: #2C74CC;
}

QToolButton#HeaderAction:pressed {
    background: #E6E6E6;
}

QPushButton#SidebarAction, QPushButton#FooterAction {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0 8px;
    color: #000000;
    font-size: 13px;
    text-align: left;
}

QPushButton#SidebarAction:hover, QPushButton#FooterAction:hover {
    background: #F4F4F5;
}

QPushButton#DangerOutlineButton {
    background: transparent;
    border: 1px solid #E7EBF0;
    border-radius: 8px;
    color: #E53935;
    padding: 6px 12px;
}

QPushButton#DangerOutlineButton:hover {
    background: #F4F4F5;
}

QPushButton#DangerFooterAction {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0 8px;
    color: #E53935;
    font-size: 13px;
}

QPushButton#DangerFooterAction:hover {
    background: #F4F4F5;
}

QLabel#FriendRequestBadge {
    background: #2C74CC;
    color: #FFFFFF;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E7EBF0;
}

QWidget#RightSidebar {
    background: #FFFFFF;
    border-left: 1px solid #E7EBF0;
}

QWidget#ChatPanel {
    background: #F4F4F5;
}

QWidget#ChatHeader {
    background: #FFFFFF;
    border-bottom: 1px solid #E7EBF0;
}

QWidget#Composer {
    background: #FFFFFF;
    border-top: 1px solid #E7EBF0;
}

QTextBrowser {
    background: #F4F4F5;
    border: none;
    padding: 8px;
}

QStackedWidget {
    background: #F4F4F5;
}

QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E7EBF0;
    color: #6A6E74;
}

QStatusBar QLabel {
    color: #6A6E74;
    padding-left: 6px;
}

QListWidget {
    background: transparent;
    border: none;
    padding: 0;
}

QListWidget[keyboardFocus="true"]:focus {
    border: 2px solid #2C74CC;
    border-radius: 10px;
}

QListWidget::item {
    padding: 9px 10px;
    border-radius: 8px;
    margin: 2px 6px;
}

QListWidget::item:hover {
    background: #F4F4F5;
    border: 1px solid transparent;
}

/* Telegram 的选中行是蓝色实底 + 白字，靠整行反色告诉用户「你在这里」，
   不靠描边。悬停仍是淡灰，未选中白底。 */
QListWidget::item:selected {
    background: #2C74CC;
    border: 1px solid #2C74CC;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #6B7076;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #6A6E74;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #6B7076;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background: #2C74CC;
    border: 1px solid #2C74CC;
    image: url(:/icons/check.png);
}

QCheckBox[keyboardFocus="true"]::indicator:focus {
    border: 2px solid #2C74CC;
}

/* 下拉框、单选、分组框原先没有任何规则，在深色主题里会回落到系统控件外观。
   不覆盖 ::down-arrow / ::drop-down：图标资源里没有 chevron，
   交给 Qt 用当前 palette 绘制反而在明暗两套下都可见。 */
QComboBox {
    background: #F1F1F1;
    border: 1px solid #E7EBF0;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 20px;
}

QComboBox:hover {
    background: #E6E6E6;
}

QComboBox:focus {
    background: #FFFFFF;
    border: 1px solid #2C74CC;
}

QComboBox:disabled {
    background: #F4F4F5;
    color: #6B7076;
}

/* ::drop-down 保留原生箭头，但必须清掉它的边框和底色，
   否则 QComboBox 本体的圆角会被这一块方角盖住。 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
}

/* 清空 ::drop-down 后原生箭头不再绘制，必须自带一张；
   没有箭头用户看不出这个控件可以展开。 */
QComboBox::down-arrow {
    image: url(:/icons/chevron-light.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E7EBF0;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #2C74CC;
    selection-color: #000000;
}

QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #6B7076;
    background: #FFFFFF;
}

/* 选中不能靠加粗 border 实现：border 会把 indicator 从 18px 撑到 28px，
   9px 圆角就不再是圆。用径向渐变画「蓝点 + 白环」，整体仍是 18px。 */
QRadioButton::indicator:checked {
    border: 1px solid #2C74CC;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                stop:0 #2C74CC, stop:0.45 #2C74CC,
                                stop:0.55 #FFFFFF, stop:1 #FFFFFF);
}

QRadioButton::indicator:disabled {
    border-color: #E7EBF0;
}

QRadioButton[keyboardFocus="true"]::indicator:focus {
    border: 2px solid #2C74CC;
}

QGroupBox {
    border: 1px solid #E7EBF0;
    border-radius: 12px;
    margin-top: 10px;
    padding: 14px 12px 10px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #6A6E74;
    font-size: 11px;
    font-weight: 600;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #E7EBF0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #F1F1F1;
    color: #000000;
}

QToolTip {
    background: #000000;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
}
QToolButton#MoreButton, QToolButton#AdvancedOptionsButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
}

QToolButton[keyboardFocus="true"]:focus {
    background: #E6E6E6;
    border: 2px solid #2C74CC;
    border-radius: 8px;
}

QToolButton#MoreButton[keyboardFocus="true"]:focus,
QToolButton#AdvancedOptionsButton[keyboardFocus="true"]:focus {
    background: #E6E6E6;
    border: 2px solid #2C74CC;
    border-radius: 8px;
}

QToolButton#MoreButton:hover, QToolButton#AdvancedOptionsButton:hover {
    background: #E6E6E6;
}

QToolButton#MoreButton:pressed, QToolButton#AdvancedOptionsButton:pressed {
    background: #E6E6E6;
}

QToolButton#MoreButton::menu-indicator {
    image: none;
    width: 0px;
}