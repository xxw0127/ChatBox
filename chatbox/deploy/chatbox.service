[Unit]
Description=ChatBox TCP Framework
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/chatbox
ExecStart=/home/ubuntu/chatbox/tools/run_server.sh --listen 127.0.0.1 --port 9100 --io-threads 4 --worker-threads 4 --max-connections 500 --max-conn-per-ip 50 --proxy-protocol --files-dir /home/ubuntu/chatbox/files
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
Environment=TZ=UTC

[Install]
WantedBy=multi-user.target
